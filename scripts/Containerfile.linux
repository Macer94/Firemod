FROM docker.io/library/ubuntu:22.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates binutils libegl1 libgl1 libopengl0 libxcb-cursor0 libxkbcommon-x11-0 \
    libx11-xcb1 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-render-util0 libxcb-xinerama0 libxcb-shape0 \
    libdbus-1-3 libfontconfig1 libglib2.0-0 libnss3 libxrender1 libxext6 libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
ENV QT_QPA_PLATFORM=offscreen
